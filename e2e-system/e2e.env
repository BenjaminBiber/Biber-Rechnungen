# Umgebung des E2E-Systems (nur Testwerte, keine echten Zugangsdaten). Genutzt von compose.sh.
POSTGRES_USER=rechnungen
POSTGRES_PASSWORD=e2e-passwort
POSTGRES_DB=rechnungen

# Werden von compose.test.yml durch benannte Volumes ersetzt, müssen aber gesetzt sein.
PFAD_EINGANG=/srv/rechnungen/eingang
PFAD_STAGING=/srv/rechnungen/staging
PFAD_ABLAGE=/srv/rechnungen/ablage
PFAD_DATEN=/srv/rechnungen/daten
PFAD_BACKUP=/srv/rechnungen/backup

APP_UID=1000
APP_GID=1000

API_PORT=8080
OEFFENTLICHE_URL=http://localhost:8080
