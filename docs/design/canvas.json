  "notes": {
    "n_app": {
      "fill": "blue",
      "page": "app",
      "text": "Look „Paperless-Indigo“: Seitenleiste und Akzent im Indigo #2F2D86 wie bei paperless-ngx, weiße Arbeitsfläche. Orange = zu prüfen, Grün = ok/bezahlt, Rot = überfällig/Fehler – immer mit Text, nie nur Farbe.\n\nSchrift: IBM Plex Sans, Beträge mit Tabellenziffern; IBM Plex Mono für Rechnungsnummern, Pfade, Hashes.\n\nIcons: Google Material Symbols.\n\nAlles ist klickbar: Seitenleiste, Tabs, Auswahl, Glocke und Benutzermenü (Play-Taste).",
      "w": 420,
      "x": -520,
      "y": 0
    },
    "n_belege": {
      "page": "app",
      "text": "Belege in drei Darstellungen wie bei paperless-ngx – umschaltbar oben rechts (Tabelle · Kleine Karten · Große Karten). Es ist dieselbe Seite; die zwei rechten Artboards zeigen sie nur mit anderer Startansicht.",
      "w": 2000,
      "x": 6000,
      "y": -180
    },
    "n_mob": {
      "fill": "teal",
      "page": "mobil",
      "text": "Bottom-Navigation statt Seitenleiste. Kein Kamera-Scan (nicht im Umfang) – Hochladen aus Dateien oder per Teilen (Android-Share-Target). Offline wartende Uploads laufen per Background Sync nach.",
      "w": 380,
      "x": 1880,
      "y": 0
    },
