# Vorlage für .env – kopieren nach .env und Werte anpassen: cp .env.example .env

# --- Datenbank (PostgreSQL) ---
POSTGRES_USER=rechnungen
# Für den Betrieb unbedingt ändern.
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=rechnungen

# --- Verzeichnisse auf dem Host (müssen existieren und für APP_UID/APP_GID beschreibbar sein) ---
# Eingangsordner (Scanner, Samba-Freigabe)
PFAD_EINGANG=/srv/rechnungen/eingang
# Zwischenablage während der Verarbeitung
PFAD_STAGING=/srv/rechnungen/staging
# Unveränderbare Belegablage
PFAD_ABLAGE=/srv/rechnungen/ablage
# Anwendungsdaten (z. B. ML-Modelle, Schlüssel)
PFAD_DATEN=/srv/rechnungen/daten
# Datenbanksicherungen (db-backup schreibt, api liest nur)
PFAD_BACKUP=/srv/rechnungen/backup

# --- Version der Images von Docker Hub (benjaminbiber/biber-rechnungen-*) ---
# latest oder ein Release wie 0.1.0; zum Aktualisieren anheben und docker compose pull && docker compose up -d
BIBER_VERSION=latest

# --- Container-Benutzer der API (Besitzer der Verzeichnisse oben) ---
APP_UID=1000
APP_GID=1000

# --- Erreichbarkeit ---
# Port auf dem Host
API_PORT=8080
# Adresse, unter der die Anwendung im LAN aufgerufen wird
OEFFENTLICHE_URL=https://rechnungen.example.lan

# --- Azure Document Intelligence (leer = Auslesen von PDFs ohne E-Rechnung abgeschaltet) ---
AZURE_DI_ENDPUNKT=
AZURE_DI_SCHLUESSEL=

# --- IMAP-Postfach für den Mail-Import (leer = Mail-Import abgeschaltet) ---
IMAP_HOST=
IMAP_PORT=993
IMAP_BENUTZER=
IMAP_PASSWORT=

# --- Google-Anmeldung (leer = Anmeldung über Google nicht verfügbar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
