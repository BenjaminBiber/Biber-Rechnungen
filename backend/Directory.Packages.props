<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Infrastructure -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="ZUGFeRD-csharp" Version="18.0.1" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
    <!-- Bildbibliothek SkiaSharp statt SixLabors.ImageSharp (Entscheidung MCA-F0001) -->
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <!-- TIFF-Dekodierung (BSD-3-Clause, verwaltet); kodiert wird weiter mit SkiaSharp -->
    <PackageVersion Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageVersion Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="Microsoft.ML" Version="6.0.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

  <!-- Api -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.15" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <PackageVersion Include="Respawn" Version="7.0.0" />
    <PackageVersion Include="WireMock.Net" Version="2.32.0" />
  </ItemGroup>
</Project>
